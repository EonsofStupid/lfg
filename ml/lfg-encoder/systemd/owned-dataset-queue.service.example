[Unit]
Description=LFG continual owned-model dataset queue

[Service]
Type=exec
Environment=HF_HUB_OFFLINE=1 TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false CUBLAS_WORKSPACE_CONFIG=:4096:8
ExecStart=/PATH/TO/PYTHON /PATH/TO/owned_dataset_queue.py --config /PATH/TO/PRIVATE_QUEUE_CONFIG.json
Restart=on-failure
RestartSec=30
CPUQuota=600%
MemoryMax=32G
TasksMax=256
NoNewPrivileges=true
UMask=0077

[Install]
WantedBy=default.target
