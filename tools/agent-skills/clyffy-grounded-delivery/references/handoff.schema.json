{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Clyffy grounded handoff v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "status",
    "objective",
    "baseline_commit",
    "evidence",
    "constraints",
    "authorized_scope",
    "anchors",
    "tasks",
    "next_task",
    "escalation_triggers"
  ],
  "properties": {
    "schema_version": {
      "const": "clyffy.handoff.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ready",
        "blocked",
        "paused",
        "completed",
        "cancelled"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "baseline_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "kind",
          "location",
          "claim"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "constraints": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authorized_scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "anchors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "normalization": {
            "enum": [
              "raw",
              "text-lf"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 250,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "status",
          "paths",
          "depends_on",
          "steps",
          "checks",
          "acceptance"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "pending",
              "in_progress",
              "complete",
              "blocked"
            ]
          },
          "paths": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "checks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": [
                "argv",
                "expected"
              ],
              "properties": {
                "argv": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "expected": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": true
            }
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "completion_evidence": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "additionalProperties": true
      }
    },
    "next_task": {
      "type": "string",
      "minLength": 1
    },
    "escalation_triggers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": true,
  "description": "Extensible structural schema. The handoff validator additionally verifies paths, graph, task readiness, completion evidence, Git ancestry and optional source digests."
}
